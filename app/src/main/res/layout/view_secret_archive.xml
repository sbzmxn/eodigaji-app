<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Sub-header count (hidden when empty) -->
    <TextView
        android:id="@+id/tvArchiveCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="최근 방문 순 · 0곳"
        android:textColor="#656769"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Main Archive Area (Empty State OR 3-Column Grid) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 3-Column Scrollable Grid -->
        <ScrollView
            android:id="@+id/svArchiveGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/llArchiveItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Empty State (06b-collection-empty) -->
        <LinearLayout
            android:id="@+id/llArchiveEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvArchiveEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아직 모은 곳이 없어요"
                android:textColor="#131417"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArchiveEmptySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="도착해서 [도감에 저장]을 누르면\n여기에 모여요"
                android:textColor="#656769"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btnArchiveNewDrive"
                android:layout_width="wrap_content"
                android:layout_height="68dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_ui_sub"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="34dp"
                android:text="출발 설정으로"
                android:textColor="#131417"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom-left Terms Link -->
    <LinearLayout
        android:id="@+id/btnArchiveViewTerms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvArchiveViewTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위치기반 서비스 이용약관"
            android:textColor="#656769"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivArchiveTermsChevron"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="#656769" />
    </LinearLayout>

</LinearLayout>
