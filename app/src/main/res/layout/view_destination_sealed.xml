<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Left Pane: 3 Clues Card + Bottom Navigation Hint -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="28dp"
        android:layout_weight="1.38"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/cardSealedClues"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_surface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingVertical="30dp">

            <!-- Clue 1: Parking -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSealedParkingIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/ic_local_parking"
                    app:tint="#131417" />

                <TextView
                    android:id="@+id/tvSealedParking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주차 가능"
                    android:textColor="#131417"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Clue 2: Fee -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSealedFeeIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/ic_receipt_free"
                    app:tint="#131417" />

                <TextView
                    android:id="@+id/tvSealedFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="무료 체험 또는 알 수 없음"
                    android:textColor="#131417"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Clue 3: Operating -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSealedOpenIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/ic_pleos_clock"
                    app:tint="#131417" />

                <TextView
                    android:id="@+id/tvSealedOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="도착 때 운영 중"
                    android:textColor="#131417"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivSealedHintIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_pleos_info"
                app:tint="#656769" />

            <TextView
                android:id="@+id/tvSealedHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내가 시작되면 내비게이션으로 넘어가요"
                android:textColor="#656769"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Dock: Dark Hero Card + Start / Redraw Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/cardSealedHeroDock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_hero_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tvSealedOverline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 비밀 장소"
                android:textColor="#A5A6A9"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSealedAlias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="숨겨진 평온"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSealedEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="편도 약 28분"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSealedUnlockHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="도착해서 주차하면 열려요"
                android:textColor="#A5A6A9"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSealedDebugCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#22FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🧪 [DEBUG] 좌표 확인"
                android:textColor="#80D8FF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnSealedDepart"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="14dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_ui_cta"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSealedDepartIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_pleos_nav_arrow"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvSealedDepartLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="안내 시작"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSealedRedraw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_sub"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="다시 뽑기"
                android:textColor="#131417"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
