<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Left Pane: Title + 4 Summary Rows + Full Terms Link -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="28dp"
        android:layout_weight="1.38"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConsentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위치 정보 이용에 동의해 주세요"
            android:textColor="#131417"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConsentSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="4dp"
            android:text="‘어디가지?’는 맞춤 목적지 추천과 블라인드 길 안내를 위해 아래와 같이 위치 정보를 이용합니다."
            android:textColor="#656769"
            android:textSize="19sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/cardConsentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ui_surface"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="34dp"
                android:paddingVertical="28dp">

                <!-- Item 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="26dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivConsentIcon1"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/ic_pleos_pin"
                        app:tint="#131417" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="수집 항목"
                            android:textColor="#656769"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="현재 위치, 추천 조건, 도착 예상 시간, 주행·기어 상태"
                            android:textColor="#131417"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Item 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="26dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivConsentIcon2"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/ic_pleos_nav_arrow"
                        app:tint="#131417" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="이용 목적"
                            android:textColor="#656769"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="목적지 추천, 블라인드 길 안내, 도착 확인, 주행 중 안전 제어"
                            android:textColor="#131417"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Item 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="26dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivConsentIcon3"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/ic_pleos_clock"
                        app:tint="#131417" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="보유 기간"
                            android:textColor="#656769"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="4dp"
                            android:text="위치 좌표는 추천할 때만 서버에서 쓰고 저장·기록하지 않아요. 주행·기어 상태는 차 안에서만 쓰고, 비밀 도감은 이 차 안에만 저장해요."
                            android:textColor="#131417"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Item 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivConsentIcon4"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="20dp"
                        android:src="@drawable/ic_pleos_info"
                        app:tint="#131417" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="거부 권리"
                            android:textColor="#656769"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="4dp"
                            android:text="동의하지 않을 수 있어요. 다만 목적지 추천과 길 안내를 쓸 수 없어요."
                            android:textColor="#131417"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/btnConsentViewTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="10dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tvConsentViewTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="약관 전문 보기"
                android:textColor="#131417"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivConsentTermsChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#131417" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Dock: Consent Card + 2 Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/cardConsentDock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_surface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="필수 동의"
                android:textColor="#656769"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="위치기반 서비스 이용 동의"
                android:textColor="#131417"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:text="동의하시면 현재 위치를 바탕으로 비밀 목적지를\n추천하고 블라인드 길 안내를 시작할 수 있어요."
                android:textColor="#656769"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/llConsentAgreeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_ui_sub"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="84dp"
                android:orientation="horizontal"
                android:paddingHorizontal="22dp"
                android:paddingVertical="20dp">

                <ImageView
                    android:id="@+id/ivConsentCheckbox"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_checkbox_unchecked" />

                <TextView
                    android:id="@+id/tvConsentCheckLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="위치기반 서비스 이용약관에 동의합니다"
                    android:textColor="#131417"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="왼쪽 ‘약관 전문 보기’에서 상세 내용을 확인할 수 있어요."
                android:textColor="#9A9B9F"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnConsentAccept"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="14dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_ui_sub"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="동의하고 시작하기"
                android:textColor="#9A9B9F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnConsentDecline"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_sub"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="동의하지 않음"
                android:textColor="#131417"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
