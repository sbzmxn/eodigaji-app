<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/pbLoadingSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginBottom="28dp"
            android:indeterminate="true"
            android:indeterminateTint="#131417" />

        <TextView
            android:id="@+id/tvLoadingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀 장소를 고르는 중… (1/3)"
            android:textColor="#131417"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadingSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="30분 · 숲, 산책 · 주차 가능한 곳만"
            android:textColor="#656769"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnLoadingCancel"
        android:layout_width="180dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_ui_sub"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="그만두기"
        android:textColor="#131417"
        android:textSize="21sp"
        android:textStyle="bold" />

</LinearLayout>
