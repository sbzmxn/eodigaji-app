<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Left Pane: Title + 3-Step Summary Card -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="28dp"
        android:layout_weight="1.38"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목적지를 봉인한 채 떠나 보세요"
            android:textColor="#131417"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHomeSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:text="도착해서 주차하면 어디인지 열려요"
            android:textColor="#656769"
            android:textSize="20sp" />

        <!-- Optional Active Trip Resume Banner (shown only when driving/unboxing trip exists) -->
        <LinearLayout
            android:id="@+id/btnHomeResumeDrive"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_ui_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvHomeResumeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="진행 중인 블라인드 드라이브 이어하기"
                android:textColor="#131417"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#131417" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardHomeSteps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_surface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="48dp"
            android:paddingVertical="36dp">

            <!-- Step 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHomeStep1"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="28dp"
                    android:src="@drawable/ic_pleos_clock"
                    app:tint="#131417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="얼마나 달릴지 고르고"
                    android:textColor="#131417"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Step 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHomeStep2"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="28dp"
                    android:src="@drawable/ic_kw_view"
                    app:tint="#131417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="끌리는 풍경을 고르면"
                    android:textColor="#131417"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Step 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHomeStep3"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="28dp"
                    android:src="@drawable/ic_pleos_lock"
                    app:tint="#131417" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="도착할 때까지 비밀로 안내해요"
                    android:textColor="#131417"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Right Dock: Dark Hero Card + Start CTA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/cardHomeHeroDock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_hero_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/tvHomeHeroOverline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 비밀 장소"
                android:textColor="#A5A6A9"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivHomeHeroLock"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/ic_pleos_lock"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnHomeStart"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_ui_cta"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="시작하기"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
