<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 기본적으로 모든 평문(HTTP) 통신 차단 및 시스템 신뢰 인증서만 허용 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
